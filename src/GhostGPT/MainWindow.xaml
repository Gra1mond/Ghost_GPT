<Window x:Class="GhostGPT.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ghost GPT" Width="1040" Height="820" MinWidth="480" MinHeight="420" Background="Transparent" Foreground="#ECECEC" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Opacity="1" SizeChanged="WindowSizeChanged">
 <Border x:Name="WindowSurface" Background="{Binding WindowBackground}" BorderBrush="#405C5C5C" BorderThickness="1" CornerRadius="16" ClipToBounds="True" SizeChanged="WindowSizeChanged">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="#18000000" CornerRadius="16,0,0,16" Padding="12,20,12,16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="BrandLabel" Text="◈  Ghost" FontSize="21" FontWeight="SemiBold" Margin="8,2,0,24" MouseLeftButtonDown="DragHeader"/>
      <Button x:Name="NewChatButton" Content="＋  Новый чат" Click="NewChat" HorizontalContentAlignment="Left" Margin="0,0,0,18" ToolTip="Новый чат"/>
      <StackPanel x:Name="Navigation"><Button Content="○  Чат" Click="ShowChat" ToolTip="Чат" Margin="0,0,0,6"/><Button Content="≋  Разговор" Click="ShowConversation" ToolTip="Разговор" Margin="0,0,0,6"/><Button Content="⚙  Настройки" Click="ShowSettings" ToolTip="Настройки" Margin="0,0,0,6"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="SidebarNote" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0,0,0"><TextBlock Text="Личное пространство" FontSize="12" Foreground="#B4B4B4"/><TextBlock Text="История — только в памяти" FontSize="11" Foreground="#888888" Margin="0,6,0,0"/></StackPanel>
     <Border/>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="24,18,24,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14" MouseLeftButtonDown="DragHeader">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Чат" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ModelLabel" FontSize="11" Foreground="#A7A7A7" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="▣" ToolTip="Компактный режим" Click="ToggleCompact" Padding="10,8" Background="Transparent"/><Button Content="—" ToolTip="Скрыть окно" Click="MinimizeWindow" Padding="10,8" Background="Transparent"/><Button Content="×" ToolTip="Закрыть приложение" Click="CloseWindow" Padding="10,8" Margin="0" Background="Transparent"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="ChatPage">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,12"><StackPanel x:Name="MessagesHost" MaxWidth="760"/></ScrollViewer>
      <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,36" IsHitTestVisible="False"><TextBlock Text="Чем могу помочь?" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Спросите, покажите задачу или начните разговор." Foreground="#B4B4B4" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="390"/></StackPanel>
      <Border x:Name="ComposerCard" Grid.Row="1" Background="{Binding PanelBackground}" BorderBrush="#40757575" BorderThickness="1" CornerRadius="22" Padding="16,12" Margin="0,12,0,0" MaxWidth="760"><StackPanel x:Name="Composer"><TextBox x:Name="PromptBox" MinHeight="58" MaxHeight="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Margin="0" Padding="2,6" FontSize="15" ToolTip="Enter — отправить, Shift+Enter — новая строка"/><Button x:Name="SendButton" Content="↑"/></StackPanel></Border>
     </Grid>
     <Grid x:Name="ConversationPage" Visibility="Collapsed"/>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="SettingsHost" MaxWidth="680"><TextBlock Text="Внешний вид и окно" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Прозрачность фона"/><TextBlock Text="Текст и кнопки остаются чёткими. Слева — плотнее, справа — прозрачнее." Foreground="#A7A7A7" FontSize="12" Margin="0,8,0,0"/><Slider x:Name="BackgroundSlider" Minimum="0" Maximum="0.85" Value="{Binding BackgroundTransparency}" Margin="0,18,0,18"/><TextBlock Text="{Binding BackgroundTransparency, StringFormat=Прозрачность фона: {0:P0}}" Foreground="#A7A7A7" FontSize="12" Margin="0,0,0,20"/></StackPanel></ScrollViewer>
    </Grid>
    <WrapPanel x:Name="CompactActions" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"><Button Content="Ответить" Click="CompactAnswer"/><Button Content="Стоп" Click="CompactCancel"/><Button Content="Копировать" Click="CompactCopy"/></WrapPanel>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="11" Margin="0,12,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <Thumb Grid.ColumnSpan="2" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeWindow"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" FontSize="11" Foreground="#707070" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3"/></Border></ControlTemplate></Thumb.Template></Thumb>
  </Grid>
 </Border>
</Window>
