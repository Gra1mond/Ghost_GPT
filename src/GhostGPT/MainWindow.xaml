<Window x:Class="GhostGPT.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ghost GPT" Width="740" Height="790" MinWidth="480" MinHeight="400" Background="#15161D" Foreground="#F3F1FA" WindowStyle="None" ResizeMode="CanResize" Opacity="{Binding WindowOpacity}">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Border Background="#15161D" BorderBrush="#424052" BorderThickness="1" CornerRadius="12" Padding="24">
  <DockPanel>
   <Grid DockPanel.Dock="Top" Margin="0,0,0,22" MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="◈  GHOST GPT" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Тихое пространство для больших идей" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="▣" ToolTip="Компактный режим" Click="ToggleCompact"/><Button Content="—" ToolTip="Свернуть" Click="MinimizeWindow"/><Button Content="×" ToolTip="Закрыть приложение" Click="CloseWindow" Margin="0"/></StackPanel>
   </Grid>
   <Border DockPanel.Dock="Bottom" BorderBrush="#30313C" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12"/></Border>
   <WrapPanel x:Name="CompactActions" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0"><Button Content="Ответить" Click="CompactAnswer"/><Button Content="Стоп" Click="CompactCancel"/><Button Content="Копировать" Click="CompactCopy"/></WrapPanel>
   <StackPanel x:Name="Navigation" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20"><Button Content="Чат" Click="ShowChat" Background="#6850C9"/><Button Content="Разговор" Click="ShowConversation"/><Button Content="Настройки" Click="ShowSettings"/></StackPanel>
   <Grid>
    <Grid x:Name="ChatPage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="Welcome" Margin="0,6,0,20"><TextBlock Text="Давайте разберёмся вместе" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Задайте вопрос или добавьте контекст. Ответ останется здесь." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
     <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesHost"/></ScrollViewer></Border>
     <StackPanel Grid.Row="2" Margin="0,16,0,0" x:Name="Composer"><TextBox x:Name="PromptBox" MinHeight="74" MaxHeight="180" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Ваш вопрос"/><Button x:Name="SendButton" Content="Отправить ↗" Background="#8061E8"/></StackPanel>
    </Grid>
    <Grid x:Name="ConversationPage" Visibility="Collapsed"/>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsHost"><TextBlock Text="Ваше пространство" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/><TextBlock Text="Прозрачность окна"/><Slider Minimum="0.55" Maximum="1" Value="{Binding WindowOpacity}" Margin="0,16,0,24"/><TextBlock Text="История текущей сессии будет храниться только в памяти." Foreground="{StaticResource Muted}"/></StackPanel></ScrollViewer>
   </Grid>
  </DockPanel>
 </Border>
</Window>
