<Window x:Class="GhostGPT.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostGPT.Controls"
 Title="Ghost GPT" Width="1040" Height="820" MinWidth="480" MinHeight="420" Background="Transparent" Foreground="#ECECEC" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Opacity="1" SizeChanged="WindowSizeChanged">
 <Border x:Name="WindowSurface" PreviewMouseLeftButtonDown="DragHeader" Background="{Binding WindowBackground}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22" ClipToBounds="True" SizeChanged="WindowSizeChanged">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Panel.ZIndex="10" Background="{Binding SidebarBackground}" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0" CornerRadius="22,0,0,22" Padding="16,20,16,18">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <DockPanel><Button x:Name="SidebarCollapse" ToolTip="Свернуть боковую панель" DockPanel.Dock="Right" Click="ToggleSidebar" Background="Transparent" Width="40" Height="40" Padding="10" Margin="0" VerticalAlignment="Top"/><Button x:Name="SearchToggle" DockPanel.Dock="Right" Click="ToggleHistorySearch" ToolTip="Поиск чатов" Width="36" Height="40" Padding="9" Margin="0" Background="Transparent" VerticalAlignment="Top"/><TextBlock x:Name="BrandLabel" Text="Ghost" FontSize="24" FontWeight="SemiBold" Margin="10,3,0,28" MouseLeftButtonDown="DragHeader"/></DockPanel>
      <Button x:Name="NewChatButton" Content="Новый чат" Background="#167D8BAF" Padding="12,12" Click="NewChat" HorizontalContentAlignment="Left" Margin="0,0,0,12" ToolTip="Новый чат"/>
      <StackPanel x:Name="SearchPanel" Visibility="Collapsed"><TextBlock Text="Поиск по сообщениям" Foreground="#929397" FontSize="12" Margin="12,0,0,4"/><TextBox x:Name="HistorySearch" ToolTip="Поиск по названию и сообщениям" TextChanged="FilterHistory" Padding="12,9" FontSize="14" Background="#182F3033" BorderBrush="#304F5055" Margin="4,4,4,16"/></StackPanel>

     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <StackPanel x:Name="Navigation" Margin="0,12,0,0"><Button Content="Чат" Click="ShowChat" ToolTip="Текущий чат" Margin="0,0,0,4" HorizontalContentAlignment="Left"/><Button Content="Разговор" Click="ShowConversation" ToolTip="Разговор" Margin="0,0,0,4" HorizontalContentAlignment="Left"/><Button Content="Настройки" Click="ShowSettings" ToolTip="Настройки" Margin="0,0,0,4" HorizontalContentAlignment="Left"/><Button Content="Инструкции" Click="ShowInstructions" ToolTip="Редактировать INTERVIEW.md" Margin="0,0,0,4" HorizontalContentAlignment="Left"/></StackPanel>
      <StackPanel x:Name="SidebarNote" Margin="8,12,0,0"><TextBlock Text="История хранится на ПК" FontSize="11" Foreground="#888888"/></StackPanel>
     </StackPanel>
     <controls:SmoothScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Чаты" FontSize="14" FontWeight="SemiBold" Foreground="#A3A6AE" Margin="12,10,0,10"/><TextBlock x:Name="HistoryCount" Foreground="#898497" FontSize="11" Margin="8,0,0,8"/><StackPanel x:Name="HistoryHost"/><DockPanel Margin="12,20,8,8"><Button x:Name="NewFolderToggle" Content="+" ToolTip="Новая папка" Click="ToggleFolderCreate" DockPanel.Dock="Right" Width="28" Height="28" Padding="4" Margin="0" Background="Transparent"/><TextBlock Text="Папки" FontSize="14" FontWeight="SemiBold" Foreground="#A3A6AE" VerticalAlignment="Center"/></DockPanel><Border x:Name="FolderCreatePanel" Visibility="Collapsed" Background="#202124" BorderBrush="#48494E" BorderThickness="1" CornerRadius="10" Padding="10" Margin="8,0,8,12"><StackPanel><TextBox x:Name="FolderName" MaxLength="60" PreviewKeyDown="FolderEditorKeyDown" ToolTip="Название папки · Enter — создать, Esc — отменить" Background="Transparent" BorderThickness="0" Padding="2,5" Margin="0"/><DockPanel Margin="0,8,0,0"><Button Content="Создать" DockPanel.Dock="Right" Click="CreateFolder" FontSize="12" Padding="10,6" Margin="0"/><Button Content="Отмена" Click="CancelFolderCreate" Background="Transparent" FontSize="12" Padding="8,6" Margin="0" HorizontalAlignment="Left"/></DockPanel></StackPanel></Border><StackPanel x:Name="FolderTreeHost"/></StackPanel></controls:SmoothScrollViewer>
    </DockPanel>
   </Border>
   <Thumb x:Name="SidebarResizer" Grid.Column="0" Panel.ZIndex="11" Width="7" HorizontalAlignment="Right" Cursor="SizeWE" ToolTip="Перетащите, чтобы изменить ширину панели" DragDelta="ResizeSidebar" DragCompleted="FinishSidebarResize">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="Transparent" Margin="2,14,1,14" CornerRadius="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#707378"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B4A7DC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
   </Thumb>
   <Grid Grid.Column="1" Margin="24,18,24,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MinHeight="48" Margin="0,0,0,14" MouseLeftButtonDown="DragHeader" ToolTip="Перетащите заголовок · двойной щелчок — развернуть">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <DockPanel VerticalAlignment="Center"><Button x:Name="SidebarToggle" DockPanel.Dock="Left" Click="ToggleSidebar" ToolTip="Показать / скрыть список чатов" Background="Transparent" Width="40" Height="40" Padding="10" Content="☰"/><StackPanel><TextBlock x:Name="PageTitle" Text="Чат" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ModelLabel" FontSize="11" Foreground="#A7A7A7" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DockPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Назад" ToolTip="За другие окна · Ctrl+Shift+Space — вернуть" Click="SendBehind" Padding="10,8" Background="Transparent"/><Button x:Name="MaxButton" Content="Развернуть" ToolTip="Развернуть / восстановить · F11 — полный экран" Click="ToggleMaximize" Padding="10,8" Background="Transparent"/><Button x:Name="CompactButton" Content="▣" ToolTip="Компактный режим" Click="ToggleCompact" Padding="10,8" Background="Transparent"/><Button x:Name="HideButton" Content="—" ToolTip="Скрыть окно" Click="MinimizeWindow" Padding="10,8" Background="Transparent"/><Button x:Name="ExitButton" Content="×" ToolTip="Закрыть приложение" Click="CloseWindow" Padding="10,8" Margin="0" Background="Transparent"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="ChatPage">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <controls:SmoothScrollViewer x:Name="MessageScroll" FollowNewContent="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,12"><StackPanel x:Name="MessagesHost" MaxWidth="760"/></controls:SmoothScrollViewer>
      <Button x:Name="LatestButton" Content="↓  К последнему сообщению" Click="GoToLatest" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" Padding="12,7" Visibility="Collapsed"/><StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,36" IsHitTestVisible="False"><TextBlock Text="Чем могу помочь?" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Спросите, покажите задачу или начните разговор." Foreground="#B4B4B4" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="390"/></StackPanel>
      <Border x:Name="ComposerCard" Grid.Row="1" Background="{Binding PanelBackground}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="22" Padding="16,12" Margin="0,12,0,0" MaxWidth="760"><StackPanel x:Name="Composer"><TextBox x:Name="PromptBox" MinHeight="58" MaxHeight="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Margin="0" Padding="2,6" FontSize="15" ToolTip="Enter — отправить, Shift+Enter — новая строка"/><Button x:Name="SendButton" Content="↑"/></StackPanel></Border>
     </Grid>
<Grid x:Name="InstructionsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Инструкции для ответов" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="INTERVIEW.md · редактируйте правила, структуру ответа и контекст собеседования. Изменения применяются к следующим запросам." Foreground="#AAAAAA" Margin="0,10,0,16"/></StackPanel><TextBox x:Name="InstructionEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Code, Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><DockPanel Grid.Row="2"><Button Content="Сохранить" Click="SaveInstructionsClick" DockPanel.Dock="Right"/><TextBlock x:Name="InstructionSaveStatus" FontSize="12" Foreground="#B8B0CA" VerticalAlignment="Center"/></DockPanel></Grid><Grid x:Name="ConversationPage" Visibility="Collapsed"/>
     <controls:SmoothScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="SettingsHost" MaxWidth="680"><TextBlock Text="Внешний вид и окно" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Прозрачность фона"/><TextBlock Text="Текст и кнопки остаются чёткими. Слева — плотнее, справа — прозрачнее." Foreground="#A7A7A7" FontSize="12" Margin="0,8,0,0"/><Slider x:Name="BackgroundSlider" Minimum="0" Maximum="0.85" Value="{Binding BackgroundTransparency}" Margin="0,18,0,18"/><TextBlock Text="{Binding BackgroundTransparency, StringFormat=Прозрачность фона: {0:P0}}" Foreground="#A7A7A7" FontSize="12" Margin="0,0,0,20"/></StackPanel></controls:SmoothScrollViewer>
    </Grid>
    <WrapPanel x:Name="CompactActions" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"><Button Content="Ответить" Click="CompactAnswer"/><Button Content="Стоп" Click="CompactCancel"/><Button Content="Копировать" Click="CompactCopy"/></WrapPanel>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="11" Margin="0,12,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <Thumb Grid.ColumnSpan="2" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeWindow"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" FontSize="11" Foreground="#707070" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3"/></Border></ControlTemplate></Thumb.Template></Thumb>
  </Grid>
 </Border>
</Window>
